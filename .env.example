# RoastMy.cv — Environment Variables

# ============ DATABASE ============
# Local dev: SQLite file
# Vercel: use Vercel Postgres (update prisma/schema.prisma provider to "postgresql")
DATABASE_URL="file:./db/roast.db"

# ============ AI (z-ai-web-dev-sdk) ============
# Already bundled in dev environment. For self-hosting, set:
# ZAI_API_KEY="your-zai-api-key"

# ============ NEXTAUTH ============
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-32-char-string"
NEXTAUTH_URL="http://localhost:3000"

# ============ GOOGLE OAUTH ============
# Get from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============ STRIPE ============
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# Publishable key (optional, only needed if using Stripe.js on client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Price ID of the Pro subscription (create in Stripe dashboard → Products)
STRIPE_PRO_PRICE_ID="price_..."
# Webhook signing secret (Stripe dashboard → Developers → Webhooks → create endpoint)
STRIPE_WEBHOOK_SECRET="whsec_..."
