// AI Resume Roaster — Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Roast {
  id        String   @id @default(cuid())
  // Resume content (truncated for storage)
  resumeText String
  // Roast mode: "roast" | "professional" | "jobmatch"
  mode      String   @default("roast")
  // Target job title (optional, for jobmatch mode)
  targetJob String?
  // AI-generated roast content (JSON: { title, score, burns[], feedback[], suggestions[] })
  result    String
  // Public sharing
  isPublic  Boolean  @default(false)
  // Anonymous nickname for public gallery
  nickname  String?
  // Sharing slug (for /r/[slug] URLs)
  slug      String   @unique
  // Language: "en" | "tr" | "de" | "es" | "fr" | "it" | "pt" | "ru" | "nl" | "zh"
  language  String   @default("en")
  // Resume score 0-100 (AI scored)
  score     Int      @default(0)
  // Client IP hash for rate limiting
  ipHash    String?
  // Owner user (if authenticated)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  createdAt DateTime @default(now())
}

model UsageStat {
  id        String   @id @default(cuid())
  ipHash    String
  count     Int      @default(0)
  lastUsed  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([ipHash])
}

// ============ AUTH (NextAuth.js v4 + Prisma Adapter) ============
model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  // Stripe customer + billing
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  stripePriceId           String?
  stripeCurrentPeriodEnd  DateTime?
  // Plan: "free" | "pro"
  plan         String          @default("free")
  accounts     Account[]
  sessions     Session[]
  roasts       Roast[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
